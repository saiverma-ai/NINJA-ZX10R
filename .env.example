# Supabase Project Credentials
# Create a new file named .env and copy this structure, then replace with your real keys from the Supabase Dashboard.

# Your unique Supabase project URL (Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon/Public Key (Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
